# Safe local demo defaults. Real staging values belong in the host secret manager.
APP_MODE=demo
APP_ORIGIN=http://localhost:3000
POLICIES_APPROVED=false
REQUIRE_LOGIN_BEFORE_BROWSING=false
PHASE_2_ENABLED=false
PHASE_3_ENABLED=false
RATE_LIMIT_STORE=postgres
# Use the existing managed project and existing owner; do not bootstrap again.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_ENCRYPTION_KEY=
SESSION_KEY_VERSION=1
SESSION_PREVIOUS_KEYS={}
IP_HASH_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_ROUTE=
# Set according to the existing ingress runbook, never an untrusted header chain.
TRUSTED_INGRESS=
